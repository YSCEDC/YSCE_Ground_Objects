IDENTIFY [YSCE]CORVETTE_VISBY
HTRADIUS 40m
STRENGTH 40
MAXSPEED 35kt
MAXROTAT 10deg
MINIDAMG 5
GRNDTYPE NAVYSHIP
HUGROUND TRUE
CARRIER user/YSCE/ground/corvette_visby.acp
MINAIMPI 0deg
MAXAIMPI 90deg
AIMROTAT 90deg
AIMPITCH 90deg
GUNRANGE 2500m
SAMRANGE 20000m
INITIGUN 99999999999999
INITISAM 99999999999999

AAAINTVL 0.05sec
GUNPRECI 1deg
AAAPOSIT  0.0m 6.0m 24.0m
AAAPOSIT  0.0m 6.0m 24.0m

MSSLTYPE AIM120
SAMRLOAD 8 20
SAMPOSIT  0.00m 7.00m -8.40m
SAMPOSIT  0.00m 7.00m -8.40m



NMTURRET 2
TURRETPO 0 4.68m 5.33m 4.64m 0deg 0deg 0deg   # Number x y z h p b
TURRETPT 0 -15deg 90deg 0deg           # Number MinPitch MaxPitch NeutralPitch
TURRETHD 0 -180deg 0deg 0deg               # Number MinHdg MaxHdg NeutralHdg
TURRETAM 0 0                              # Ammo
TURRETIV 0 60sec                              # Number ShootingInterval
TURRETAR 0 TRUE
TURRETCT 0 GUNNER                            # Controlled by PILOT or GUNNER
TURRETRG 0 20000m
TURRETWP 0 AGM65
TURRETPO 1 -4.68m 5.33m 4.64m 0deg 0deg 0deg   # Number x y z h p b
TURRETPT 1 -15deg 90deg 0deg           # Number MinPitch MaxPitch NeutralPitch
TURRETHD 1 0deg 180deg 0deg               # Number MinHdg MaxHdg NeutralHdg
TURRETAM 1 0                              # Ammo
TURRETIV 1 60sec                              # Number ShootingInterval
TURRETAR 1 TRUE
TURRETCT 1 GUNNER                            # Controlled by PILOT or GUNNER
TURRETRG 1 20000m
TURRETWP 1 AGM65
