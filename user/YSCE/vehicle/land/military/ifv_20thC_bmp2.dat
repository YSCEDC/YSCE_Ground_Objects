IDENTIFY [YSCE]IFV_20thC_BMP-2
HTRADIUS 5m
STRENGTH 6
MAXSPEED 100km/h
MAXROTAT 30deg
ANTIGRND TRUE
HUGROUND TRUE
GRNDTYPE TANK

